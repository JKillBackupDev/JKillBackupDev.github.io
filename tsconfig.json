{
	"compilerOptions": {
		"types": ["vite/client", "vite-plugin-svgr/client"],
		"baseUrl": ".",
		"paths": {
			"@/*": ["./src/*"],
			"@assets/*": ["./src/assets/*"],
			"@components/*": ["./src/components/*"],
			"@locales/*": ["./src/locales/*"],
			"@contexts/*": ["./src/contexts/*"],
			"@plugins/*": ["./src/plugins/*"]
		},
		"allowJs": true
	},
	"files": [],
	"references": [
		{ "path": "./tsconfig.app.json" },
		{ "path": "./tsconfig.node.json" }
	]
}
